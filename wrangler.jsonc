// Cloudflare Worker: serves the static Next.js export (out/) and the API under /api/*.
// Secrets (GOOGLE_CLIENT_SECRET, GEMINI_API_KEY, ...) go in .dev.vars locally and `wrangler secret put` in production.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karuai",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static pages are served without running the Worker (free, not counted against the request quota);
  // only /api/* requests run it.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    // The public address of the app, used for the Google sign-in redirect and the Origin check.
    // .dev.vars overrides it with http://localhost:3000 for local development.
    "APP_URL": "https://karuai.example.workers.dev",
    // Polar payments: "production" or "sandbox" (api.polar.sh or sandbox-api.polar.sh), and the Polar product of
    // each paid plan. .dev.vars overrides them with the sandbox products. The access token and webhook secret
    // are secrets: `wrangler secret put POLAR_ACCESS_TOKEN` and `wrangler secret put POLAR_WEBHOOK_SECRET`.
    "POLAR_SERVER": "production",
    "POLAR_PRODUCT_BASIC": "74e826e5-5645-4c6c-a5fd-a4be89c4d2ba",
    "POLAR_PRODUCT_PRO": "ee7d6624-49e6-4b16-a48e-b7ba84122e28",
    "POLAR_PRODUCT_VIP": "2e25cee7-426f-4e14-9ec9-e63de3ddd7ee"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "karuai",
      // Replace with the id printed by `npx wrangler d1 create karuai` before the first deploy
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    // Carousel documents, undo histories, Gemini conversations, thumbnails and images
    { "binding": "FILES", "bucket_name": "karuai-files" }
  ],

  // Daily cleanup of expired sessions and old rate-limit and usage rows
  "triggers": { "crons": ["17 3 * * *"] },

  "observability": { "enabled": true },

  "dev": { "port": 8787 }
}
