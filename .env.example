# Copy this file to .env.local and fill in your key (never commit .env.local)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Pollinations key for image generation (can also be set on the Admin page)
POLLINATIONS_API_KEY=

# Admin account, created on the first start if no user with this email exists
ADMIN_EMAIL=
ADMIN_PASSWORD=
