# Copy to .dev.vars for `npm run dev` (never commit .dev.vars). In production set each with `npx wrangler secret put NAME`.
APP_URL=http://localhost:3000

# Google sign-in: https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback (and https://<your domain>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The Google account with this email becomes an admin when it signs in
ADMIN_EMAIL=

# AI keys (can also be set on the Admin page). Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=
POLLINATIONS_API_KEY=

# Polar payments, against the sandbox (https://sandbox.polar.sh, test card 4242 4242 4242 4242).
# Settings -> Developers: create an Organization Access Token (scopes checkouts:write, customer_sessions:write).
# Settings -> Webhooks: add <public address>/api/billing/webhook (e.g. a `cloudflared tunnel` to localhost:3000),
# format Raw, events subscription.*, and paste its secret here.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# The ids of the sandbox products (each product's page -> Copy ID)
POLAR_PRODUCT_BASIC=
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_VIP=

# Optional: Sentry DSN for errors in the API Worker
SENTRY_DSN=

# Local only: shows a "Dev login" form so you can sign in without Google. Ignored unless APP_URL is localhost.
DEV_LOGIN=true
