# Settings for the static site (next build / next dev). Copy to .env.local.
# The API Worker's settings and secrets live in .dev.vars instead (see .dev.vars.example).

# PostHog (works in dev & prod; session replay only in prod)
NEXT_PUBLIC_POSTHOG_DEV_KEY=phc_dev_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_PROD_KEY=phc_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com # Or https://eu.i.posthog.com

# Sentry source map upload during `next build` (optional)
SENTRY_AUTH_TOKEN=

# Microsoft Clarity (production only)
NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx

# Google Analytics 4 (production only)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# The public address of the site (must match APP_URL in wrangler.jsonc), for SEO metadata and the sitemap
NEXT_PUBLIC_SITE_URL=https://karuai.example.workers.dev

# Public contact addresses shown on the legal, contact and cancel pages (see shared/business.ts for the other details)
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_ACCESSIBILITY_EMAIL=
NEXT_PUBLIC_LEGAL_EMAIL=

# The Polar customer portal of the live organization (https://polar.sh/<organization slug>/portal), linked from /cancel
NEXT_PUBLIC_POLAR_PORTAL_URL=
