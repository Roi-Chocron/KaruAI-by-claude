# Copy this file to .env.local and fill in your key (never commit .env.local)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Pollinations key for image generation (can also be set on the Admin page)
POLLINATIONS_API_KEY=

# Admin account, created on the first start if no user with this email exists
ADMIN_EMAIL=
ADMIN_PASSWORD=

# -------------------------------------------------------------
# Analytics & Error Monitoring Configuration
# -------------------------------------------------------------

# PostHog (Works in Dev & Prod; Replay strictly enabled in Prod only)
NEXT_PUBLIC_POSTHOG_DEV_KEY=phc_dev_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_PROD_KEY=phc_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com # Or https://eu.i.posthog.com

# Sentry / GlitchTip (Works in both Dev & Prod)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxx@sentry.io/1234567
SENTRY_DSN=https://xxxxxxxxxxxxxxxx@sentry.io/1234567

# Sentry Build/CLI Configuration (Optional for source maps upload during build)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Microsoft Clarity (Strictly Production Only)
NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx

# Google Analytics 4 (GA4) (Strictly Production Only)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
