# Settings for the static site (next build / next dev). Copy to .env.local.
# The API Worker's settings and secrets live in .dev.vars instead (see .dev.vars.example).

# PostHog (works in dev & prod; session replay only in prod)
NEXT_PUBLIC_POSTHOG_DEV_KEY=phc_dev_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_PROD_KEY=phc_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com # Or https://eu.i.posthog.com

# Sentry source map upload during `next build` (optional)
SENTRY_AUTH_TOKEN=

# Microsoft Clarity (production only)
NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx

# Google Analytics 4 (production only)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
